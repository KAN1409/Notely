<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_widget_card"
    android:padding="12dp">

    <!-- Top header: Notely & 4 quick buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Notely"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_widget_note"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_widget_button"
            android:contentDescription="New Note"
            android:src="@drawable/ic_widget_note"
            android:padding="8dp" />

        <ImageButton
            android:id="@+id/btn_widget_record"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_widget_button"
            android:contentDescription="Record Voice"
            android:src="@drawable/ic_widget_mic"
            android:padding="8dp" />

        <ImageButton
            android:id="@+id/btn_widget_scan"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_widget_button"
            android:contentDescription="Scan Document"
            android:src="@drawable/ic_widget_scan"
            android:padding="8dp" />

        <ImageButton
            android:id="@+id/btn_widget_link"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_widget_button"
            android:contentDescription="Add Link"
            android:src="@drawable/ic_widget_link"
            android:padding="8dp" />
    </LinearLayout>

    <!-- Bottom summary row -->
    <LinearLayout
        android:id="@+id/widget_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#15212E"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <TextView
            android:id="@+id/widget_status_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Today: 2 reminders • 3 follow-ups"
            android:textColor="#A0B2C6"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/btn_widget_mic"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_widget_button"
            android:contentDescription="Quick Record"
            android:src="@drawable/ic_widget_mic"
            android:padding="6dp" />
    </LinearLayout>

</LinearLayout>
